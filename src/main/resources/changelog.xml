    </changeSet>

    <changeSet id="10-remove-trigger-on-log-detail" author="Qifeng Bai">
        <sql>
            DROP TRIGGER IF EXISTS update_breakdown_summary_information;
        </sql>
    </changeSet>

    <!--Make sure DB has already SET GLOBAL event_scheduler = ON;-->
    <changeSet id="10-schedule-process-month-events" author="Qifeng Bai">
        <sql>
            CREATE EVENT IF NOT EXISTS process_new_events_hourly
            ON SCHEDULE EVERY 1 HOUR
            STARTS CURRENT_TIMESTAMP
            DO
            CALL process_new_events();
        </sql>
    </changeSet>
</databaseChangeLog>

