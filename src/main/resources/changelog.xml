<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:pro="http://www.liquibase.org/xml/ns/pro" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/pro http://www.liquibase.org/xml/ns/pro/liquibase-pro-4.6.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <!-- Base schema creation -->
    <changeSet id="0.0-create-base-schema" author="ALA Dev Team">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="log_event" />
            </not>
        </preConditions>
        <comment>Create base database schema for logger service</comment>
        <sqlFile path="sql/V0_base_schema.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 endDelimiter=";"/>
    </changeSet>

    <!-- Seed data for lookup tables -->
    <changeSet id="0.1-seed-lookup-tables" author="ALA Dev Team" runAlways="false">
        <preConditions onFail="HALT">
            <and>
                <tableExists tableName="log_event_type" />
                <tableExists tableName="log_reason_type" />
                <tableExists tableName="log_source_type" />
            </and>
        </preConditions>
        <comment>Insert/update seed data for event types, reason types, and source types</comment>
        <sqlFile path="sql/V0_seed_data.sql"
                 relativeToChangelogFile="true"
                 splitStatements="true"
                 endDelimiter=";"/>
    </changeSet>

    <!-- Trigger for real-time summary table updates -->
    <changeSet id="0.2-drop-old-trigger" author="ALA Dev Team">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="log_detail" />
        </preConditions>
        <comment>Drop old trigger if exists</comment>
        <sql>DROP TRIGGER IF EXISTS `update_breakdown_summary_information`</sql>
    </changeSet>

    <changeSet id="0.3-create-summary-update-trigger" author="ALA Dev Team">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="log_detail" />
            <tableExists tableName="event_summary_totals" />
        </preConditions>
        <comment>Create trigger to automatically update summary tables when log_detail records are inserted</comment>
        <sqlFile path="sql/V0_trigger_update_summary.sql"
                 relativeToChangelogFile="true"
                 splitStatements="false"/>
    </changeSet>

    <!-- required indexes for log_event to allow faster/more efficient sorting. -->

    <changeSet author="ALA Dev Team" id="1">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_event" columnNames="month" />
            </not>
        </preConditions>
        <createIndex indexName="month_idx" tableName="log_event">
            <column name="month"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="2">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_event" columnNames="log_event_type_id" />
            </not>
        </preConditions>
        <createIndex indexName="log_event_type_id_idx" tableName="log_event">
            <column name="log_event_type_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="3">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_event" columnNames="log_source_type_id" />
            </not>
        </preConditions>
        <createIndex indexName="log_source_type_id_idx" tableName="log_event">
            <column name="log_source_type_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="4">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_event" columnNames="log_reason_type_id" />
            </not>
        </preConditions>
        <createIndex indexName="log_reason_type_id_idx" tableName="log_event">
            <column name="log_reason_type_id"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="5">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_event" columnNames="user_email" />
            </not>
        </preConditions>
        <createIndex indexName="user_email_idx" tableName="log_event">
            <column name="user_email"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="6">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_event" columnNames="source" />
            </not>
        </preConditions>
        <createIndex indexName="source_idx" tableName="log_event">
            <column name="source"/>
        </createIndex>
    </changeSet>

    <!-- required indexes for log_detail to allow faster/more efficient sorting.-->

    <changeSet author="ALA Dev Team" id="7">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_detail" columnNames="entity_type" />
            </not>
        </preConditions>
        <createIndex indexName="entity_type_idx" tableName="log_detail">
            <column name="entity_type"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="8">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_detail" columnNames="entity_uid" />
            </not>
        </preConditions>
        <createIndex indexName="entity_uid_idx" tableName="log_detail">
            <column name="entity_uid"/>
        </createIndex>
    </changeSet>

    <changeSet author="ALA Dev Team" id="9">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists tableName="log_detail" columnNames="record_count" />
            </not>
        </preConditions>
        <createIndex indexName="record_count_idx" tableName="log_detail">
            <column name="record_count"/>
        </createIndex>
    </changeSet>

    <changeSet id="10-prerequisite-index-for-summary-aggregation" author="Qifeng Bai">
        <addUniqueConstraint
                tableName="event_summary_breakdown_email"
                columnNames="month, log_event_type_id, user_email_category"
                constraintName="uq_month_event_email"/>
        <addUniqueConstraint
                tableName="event_summary_breakdown_email_entity"
                columnNames="month, log_event_type_id, user_email_category, entity_uid"
                constraintName="uq_month_event_email_entity"/>
        <addUniqueConstraint
                tableName="event_summary_breakdown_reason"
                columnNames="month, log_event_type_id, log_reason_type_id"
                constraintName="uq_month_event_reason"/>
        <addUniqueConstraint
                tableName="event_summary_breakdown_reason_entity"
                columnNames="month, log_event_type_id, log_reason_type_id, entity_uid"
                constraintName="uq_month_event_reason_entity"/>
        <addUniqueConstraint
                tableName="event_summary_breakdown_reason_entity_source"
                columnNames="month, log_event_type_id, log_reason_type_id, entity_uid, log_source_type_id"
                constraintName="uq_month_event_reason_entity_source"/>
        <addUniqueConstraint
                tableName="event_summary_totals"
                columnNames="month, log_event_type_id"
                constraintName="uq_month_event"/>
    </changeSet>

    <changeSet id="10-add-stored-procedures-to-summary-tables" author="Qifeng Bai">
        <sqlFile path="sql/V1_sp_update_event_summary_total.sql"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_email.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_email_entity.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_reason.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_reason_entity.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_reason_entity_source.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_process_month_events.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
    </changeSet>

</databaseChangeLog>
