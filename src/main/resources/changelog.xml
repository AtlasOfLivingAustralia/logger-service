<!--    Adding those statements to the stored procedure SQL files may cause liquibase to fail to parse them. -->
<!--    So we put them here to drop existing stored procedures first.-->
    <changeSet id="10-drop-stored-procedures-if-exist" author="Qifeng Bai">
        <sql>
            DROP PROCEDURE IF EXISTS process_new_events;
            DROP PROCEDURE IF EXISTS process_month_events;
            DROP PROCEDURE IF EXISTS process_year_events;
            DROP PROCEDURE IF EXISTS process_event_summary_totals;
            DROP PROCEDURE IF EXISTS process_event_summary_breakdown_reason;
            DROP PROCEDURE IF EXISTS process_event_summary_breakdown_reason_entity;
            DROP PROCEDURE IF EXISTS process_event_summary_breakdown_reason_entity_source;
            DROP PROCEDURE IF EXISTS process_event_summary_breakdown_email;
            DROP PROCEDURE IF EXISTS process_event_summary_breakdown_email_entity;
        </sql>
    </changeSet>

    <!-- keep track of the last processed event ID for summary procedures -->
    <changeSet id="10-create-event-processing-checkpoint" author="bai">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="event_processing_checkpoint"/>
            </not>
        </preConditions>

        <createTable tableName="event_processing_checkpoint">
            <column name="id" type="INT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="last_processed_event_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>

        <comment>Tracks the last processed event ID for summary procedures. Only one row (id=1) is expected</comment>
        <insert tableName="event_processing_checkpoint">
            <column name="id" valueNumeric="1"/>
            <column name="last_processed_event_id" valueNumeric="0"/>
        </insert>

        <comment>Initialize the last_processed_event_id to the current max ID in log_event to avoid processing old events.
            e.g. Event ID:62313 is the last record of July 2025 in ALA Logger prod, if we set last_processed_event_id=62313, the aggregation will start for the first event of Aug 2025
        </comment>
        <sql>
            UPDATE event_processing_checkpoint
            SET last_processed_event_id = (SELECT MAX(id) FROM log_event)
            WHERE id = 1;
        </sql>
    </changeSet>

    <changeSet id="10-add-stored-procedures-to-summary-tables" author="Qifeng Bai">
        <sqlFile path="sql/V1_sp_update_event_summary_total.sql"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_email.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_email_entity.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_reason.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_reason_entity.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_update_event_summary_breakdown_reason_entity_source.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_process_month_events.sql" splitStatements="false"
                 relativeToChangelogFile="true"
                 endDelimiter=";"/>
        <sqlFile path="sql/V1_sp_process_year_events.sql" splitStatements="false"
